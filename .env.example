# Copy to .env and adjust. docker compose reads .env automatically.

# --- docker-compose ---
# GHCR image owner/repo (ghcr.io/<this>:latest)
GITHUB_REPOSITORY=owner/singpulse

# --- Backend (packages/backend) ---
# HTTP port the Fastify server listens on
PORT=3000
# Party token guests need to join. Leave empty for a random token per start
# (shown on the TV QR code and in the logs).
PARTY_TOKEN=
# Public URL encoded in the TV's QR code for the mobile remote
PUBLIC_REMOTE_URL=https://sing.yourdomain.com
# Max size of the yt-dlp download cache in GB (oldest files evicted first)
MAX_CACHE_GB=25
# Cache directory (Docker image uses /app/cache; override for local dev)
# CACHE_DIR=./cache
# Built frontend served by the backend (defaults to ../../frontend/dist)
# FRONTEND_DIST=

# --- Android TV build (packages/frontend/capacitor.config.ts) ---
# Receiver URL baked into the APK at build time
# CAP_SERVER_URL=http://192.168.1.100:3000/tv
