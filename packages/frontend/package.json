{
  "name": "@singpulse/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SingPulse Vue 3 app: Android TV stage receiver (/tv) and guest phone remote (/remote).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.json",
    "cap:sync": "cap sync android",
    "pwa:assets": "pwa-assets-generator && mv pwa/*.png pwa/*.ico public/"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@singpulse/shared": "workspace:*",
    "lucide-vue-next": "1.0.0",
    "pinia": "4.1.0",
    "qrcode.vue": "3.11.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vue-tsc": "3.3.13",
    "workbox-window": "7.4.1"
  }
}
