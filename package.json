{
  "name": "singpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted karaoke: headless Node 24 server, Android TV receiver and phone remote.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @singpulse/backend --filter @singpulse/frontend dev",
    "build": "pnpm --filter @singpulse/frontend build",
    "start": "pnpm --filter @singpulse/backend start",
    "lint": "oxlint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "1.90.0"
  }
}
